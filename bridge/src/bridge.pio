; Програми PIO мосту (блок PIO1; PIO0 — прийом AES бібліотекою pico_spdif_rx).
; Частота RP2040 — 200 МГц (з SDK 2.1 офіційно; напругу ядра SDK ставить сам). Від неї цілими дільниками: MCLK 12,5 МГц,
; BCK 2,0833 МГц, LRCK 32,552 кГц = MCLK / 384 — режим PCM1808 «384 fs», усі три такти від одного джерела (PCM1808
; цього вимагає: інакше раз на ~0,1 с він сам перезапускається). Бібліотеці AES PIO0 ділиться до 125 МГц (spdif_rx.h).

; MCLK (12,5 МГц) дає ШІМ (main.c): місце в PIO1 потрібне точній перевірці виходу (link_tx). Окремої програми для I2S
; немає: у наборі FMT на землі (I2S, власник 23.10), і запізнення даних на біт та обмін каналів (в I2S лівий — при
; LRCK = 0) міст робить сам (pcmPull, pcmShift).

; ---- PCM1808, читання «лівовирівняне» (як для FMT на 3,3 В): LRCK = 1 — перше слово пари, старший біт — одразу з
; фронтом LRCK. Міст — ведучий (MD0 = MD1 = земля). Бокові біти: 0 — BCK, 1 — LRCK. Ділення 24 → 8,33 МГц,
; 4 такти на біт: «0» — 2, «1» — 2; біт даних читається на фронті BCK. Слово — 32 біти на канал (24 біти даних,
; старший — біт 31), автоштовхання.
.program pcm_lj
.side_set 2
.wrap_target
    set x, 30       side 0b10 [1]
    in pins, 1      side 0b11 [1]
lbit:
    nop             side 0b10 [1]
    in pins, 1      side 0b11
    jmp x-- lbit    side 0b11
    set x, 30       side 0b00 [1]
    in pins, 1      side 0b01 [1]
rbit:
    nop             side 0b00 [1]
    in pins, 1      side 0b01
    jmp x-- rbit    side 0b01
.wrap

; ---- Вихід до передавача: I2S (Philips), міст — ведений. Такти дає передавач: BCK — вхід 0 (IN_BASE), LRCK — вхід 1
; і JMP_PIN; дані — OUT_BASE. 32-бітні слова, старшим бітом уперед, автовитягування. Дані міняються на спаді BCK,
; передавач читає на фронті; старший біт лівого слова — на другому спаді після спаду LRCK.
; Перевірка на кожному кадрі: на фронті після 31-го біта лівого слова LRCK має бути 0, після 32-го — 1. Зсув на будь-яке
; число бітів ламає одну з двох умов (перша версія перевіряла лише кінець кадру й не бачила зсуву менше 32 біт: після
; перезапуску передавача вихід раз «з'їхав» на 8 біт — у навушниках шипіння й тріск, доки Pico не скинули).
; Збилися — IRQ 0 і чекати: ядро 1 зупиняє вихід, ставить читання з межі кадру й пускає знову (main.c, linkRecover).
.program link_tx
public sync:
    wait 1 pin 1
    wait 0 pin 1
    wait 0 pin 0
    wait 1 pin 0
.wrap_target
    set x, 30
lbits:
    wait 0 pin 0
    out pins, 1
    wait 1 pin 0
    jmp x-- lbits
    jmp pin lost
    wait 0 pin 0
    out pins, 1
    wait 1 pin 0
    jmp pin rhalf
lost:
    irq wait 0
    jmp sync
rhalf:
    set x, 31
rbits:
    wait 0 pin 0
    out pins, 1
    wait 1 pin 0
    jmp x-- rbits
.wrap
